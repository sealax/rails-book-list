<section class="page-header">
  <div>
    <p class="page-eyebrow">Library</p>
    <h1>Reading Lists</h1>
    <p class="page-subtitle"><%= pluralize(@lists.count, "list") %> in your collection</p>
  </div>

  <%= link_to "New list", new_list_path, class: "btn btn-primary" %>
</section>

<section class="list-grid">
  <% @lists.each do |list| %>
    <%= link_to list_path(list), class: "list-card" do %>
      <span class="list-card__title"><%= list.name %></span>
      <span class="list-card__meta"><%= pluralize(list.bookmarks.count, "book") %></span>
    <% end %>
  <% end %>
</section>
