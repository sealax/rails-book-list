<h1>Add a book to <%= @list.name %></h1>

<%= form_with url: new_list_bookmark_path(@list), method: :get, local: true do %>
  <%= text_field_tag :query, params[:query], placeholder: "Search for a book" %>
  <%= submit_tag "Search" %>
<% end %>

<% @results.each do |book| %>
  <div>
    <h3><%= book["title"] %></h3>

    <% if book["author_name"] %>
      <p><%= book["author_name"].first %></p>
        <%= form_with url: list_bookmarks_path(@list), method: :post, local: true do %>
          <%= hidden_field_tag :title, book["title"] %>
          <%= hidden_field_tag :author, book["author_name"]&.first %>
          <%= hidden_field_tag :open_library_key, book["key"] %>
          <%= hidden_field_tag :cover_url, book["cover_i"] ? "https://covers.openlibrary.org/b/id/#{book["cover_i"]}-L.jpg" : "" %>

          <%= text_area_tag :comment, nil, placeholder: "Add a comment" %>
          <%= number_field_tag :rating, nil, min: 0, max: 5, step: 0.5, placeholder: "Rating" %>

          <%= submit_tag "Add to list" %>
        <% end %>
    <% end %>
  </div>
<% end %>
