<section class="page-header">
  <div>
    <p class="page-eyebrow">Add book</p>
    <h1><%= @list.name %></h1>
    <p class="page-subtitle">Search Open Library and save a title with your notes.</p>
  </div>

  <%= link_to "Back", list_path(@list), class: "btn btn-outline-secondary" %>
</section>

<%= form_with url: new_list_bookmark_path(@list), method: :get, local: true, class: "search-panel" do %>
  <%= text_field_tag :query, params[:query], class: "form-control", placeholder: "Search for a book" %>
  <%= submit_tag "Search", class: "btn btn-primary" %>
<% end %>

<section class="search-results">
  <% @results.each do |book| %>
    <article class="result-card">
      <div>
        <h2><%= book["title"] %></h2>

        <% if book["author_name"] %>
          <p><%= book["author_name"].first %></p>
        <% end %>
      </div>

      <% if book["author_name"] %>
        <%= form_with url: list_bookmarks_path(@list), method: :post, local: true, class: "result-card__form" do %>
          <%= hidden_field_tag :title, book["title"] %>
          <%= hidden_field_tag :author, book["author_name"]&.first %>
          <%= hidden_field_tag :open_library_key, book["key"] %>
          <%= hidden_field_tag :cover_url, book["cover_url"] || (book["cover_i"] ? "https://covers.openlibrary.org/b/id/#{book["cover_i"]}-L.jpg" : "") %>

          <%= text_area_tag :comment, nil, class: "form-control", placeholder: "Add a comment" %>
          <%= number_field_tag :rating, nil, class: "form-control", min: 0, max: 5, step: 0.5, placeholder: "Rating" %>

          <%= submit_tag "Add to list", class: "btn btn-outline-primary" %>
        <% end %>
      <% end %>
    </article>
  <% end %>
</section>
